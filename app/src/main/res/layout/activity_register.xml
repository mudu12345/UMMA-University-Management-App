<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/umma_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- University Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@color/umma_dark_blue">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="UMMA UNIVERSITY"
                android:textColor="@color/umma_gold"
                android:textSize="23sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="UNIVERSITY MANAGEMENT SYSTEM"
                android:textColor="@color/umma_white"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Registration Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Create Account"
            android:textColor="@color/umma_dark_blue"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="22dp"
            android:text="Register for UMMA University services"
            android:textColor="@color/umma_secondary_text"
            android:textSize="15sp" />

        <!-- Full Name -->
        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Full name"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:padding="14dp"
            android:backgroundTint="@color/umma_blue"
            android:layout_marginBottom="12dp" />

        <!-- Registration Number -->
        <EditText
            android:id="@+id/etRegNumber"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Registration number or staff ID"
            android:inputType="text"
            android:singleLine="true"
            android:padding="14dp"
            android:backgroundTint="@color/umma_blue"
            android:layout_marginBottom="12dp" />

        <!-- Email -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Email address"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:padding="14dp"
            android:backgroundTint="@color/umma_blue"
            android:layout_marginBottom="12dp" />

        <!-- Department -->
        <EditText
            android:id="@+id/etDepartment"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Department"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:padding="14dp"
            android:backgroundTint="@color/umma_blue"
            android:layout_marginBottom="12dp" />

        <!-- Password -->
        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Create password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="14dp"
            android:backgroundTint="@color/umma_blue"
            android:layout_marginBottom="12dp" />

        <!-- Confirm Password -->
        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Confirm password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="14dp"
            android:backgroundTint="@color/umma_blue"
            android:layout_marginBottom="16dp" />

        <!-- User Role -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Account Role"
            android:textColor="@color/umma_text"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerRegisterRole"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:entries="@array/user_roles"
            android:backgroundTint="@color/umma_blue"
            android:layout_marginBottom="24dp" />

        <!-- Register Button -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CREATE ACCOUNT"
            android:textColor="@color/umma_white"
            android:textStyle="bold"
            android:backgroundTint="@color/umma_dark_blue" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="© 2026 UMMA UNIVERSITY"
            android:textColor="@color/umma_secondary_text"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
