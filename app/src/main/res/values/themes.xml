<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.UMMAUNIVERSITYAPP"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- University Brand Colours -->
        <item name="colorPrimary">@color/umma_blue</item>
        <item name="colorOnPrimary">@color/umma_white</item>

        <item name="colorSecondary">@color/umma_gold</item>
        <item name="colorOnSecondary">@color/umma_dark_blue</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/umma_background</item>
        <item name="colorSurface">@color/umma_white</item>
        <item name="colorOnSurface">@color/umma_text</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/umma_dark_blue</item>
        <item name="android:navigationBarColor">@color/umma_dark_blue</item>

        <!-- System Appearance -->
        <item name="android:windowLightStatusBar">false</item>

    </style>

    <style name="Theme.UMMAUNIVERSITYAPP"
        parent="Base.Theme.UMMAUNIVERSITYAPP" />

</resources>